# Leave these empty to run on the Cnamio sandbox (no account). Set them in the server environment to use your own
# application (for example: uvicorn app.main:app --env-file .env). Never commit real values or paste them into a chat.
CNAMIO_APPLICATION_ID=
CNAMIO_SECRET=
# Any long random string of yours: makes the ownership TXT record unique per user (required with credentials).
CNAMIO_OWNERSHIP_KEY=
# From the dashboard (or GET /v1/manage/webhook-secret); the sandbox sends no webhooks.
CNAMIO_WEBHOOK_SECRET=
# What your users' domains point to: your hosting's custom-hostname target.
CUSTOM_DOMAIN_TARGET=customers.example-saas.com
